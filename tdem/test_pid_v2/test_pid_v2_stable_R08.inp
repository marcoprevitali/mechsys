0.05     = Verlet:          Verlet distance for neighbour searching
0        = RenderVideo:     1 writes XDMF output, 0 disables it
1.0      = fraction:        Fraction of HCP lattice sites occupied
2.0e4    = Kn:              Normal stiffness
2.0e4    = Kt:              Tangential stiffness
-0.2      = Gn:              Normal restitution coefficient
-0.2      = Gt:              Tangential restitution coefficient
0.3      = Mu:              Particle friction coefficient
0.5      = R:               Particle radius
0.8      = RRatio:          Minimum-to-maximum particle radius ratio
1000     = seed:            Random seed
0.00005  = dt:              Integration time step
1.0      = dtOut:           Output interval
10.0      = Lx:              Initial specimen length in X
10.0      = Ly:              Initial specimen length in Y
10.0      = Lz:              Initial specimen length in Z
1.0      = rho:             Particle density
1.0      = pressure:        Positive confining-pressure magnitude
100.0      = isotropicEnd:    End time of isotropic compression
-0.001    = axialVelocity:   Velocity of the +Z wall (negative is compression)
200.0      = shearEnd:        End time of constant-velocity loading
0.02     = pidKp:           Proportional gain for normalized stress error
0.0      = pidKi:           Integral gain for normalized stress error
0.0      = pidKd:           Derivative gain for normalized stress error
