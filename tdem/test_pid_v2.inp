0.05     = Verlet:      Verlet distance for optimization
sphereboxhcp  = ptype:       Particle type
0      = RenderVideo: 1 if video should be render, 0 otherwise
0.4    = fraction:    Fraction of Particles to appear
1.0e4 = Kn:          Normal stiffness
1.0e4  = Kt:          Tangential stiffness
0.1    = Gn:          Normal dissipative coefficient
0.0     = Gt:          Tangential dissipative coefficient
0.2     = Mu:          Microscopic friction coefficient
0.12    = Beta:        Rolling stiffness coefficient (only for spheres)
0.5     = Eta:         Plastic moment coefficient
1.0e3  = Bn:          Cohesion Normal stiffness
1.0e3  = Bt:          Cohesion Tangential stiffness
1.0e3  = Bm:          Cohesion Torque stiffness
0.0     = Eps:        Cohesion Threshold
0.1     = R:           Spheroradius
1000    = seed:        Seed of the random generator
0.00001   = dt:          Time step
0.1     = dtOut:       Time step for output
3.0    = Lx:          Lx (length of sphere cube)
3.0   = Ly:          Ly
3.0    = Lz:          Lz
15      = nx:          nx (number of spheres per cube size)
15     = ny:          ny
15      = nz:          nz
2.6     = rho:         rho
1.0e4     = p0:          Pressure for the isotropic compression
1.0     = T0:          Time span for the compression
1       = pssrz:       Prescribed strain rate in Z ?
-0.2    = srz:         Final Strain z
1.0e4     = pf:          Final pressure p
0.0     = qf:          Final deviatoric stress q
2.0    = Tf:          Final time for the test