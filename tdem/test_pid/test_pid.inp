0.01     = Verlet:      Verlet distance for optimization
sphereboxhcp  = ptype:       Particle type (voronoi, sphere and rice and tetrahedra mesh so far)
0      = RenderVideo: 1 if video should be render, 0 otherwise
0.4    = fraction:    Fraction of Particles to appear
1.0e4 = Kn:          Normal stiffness
1.0e4  = Kt:          Tangential stiffness
0.1    = Gn:          Normal dissipative coefficient
0.0     = Gt:          Tangential dissipative coefficient
0.2     = Mu:          Microscopic friction coefficient
0.12    = Beta:        Rolling stiffness coefficient (only for spheres)
0.5     = Eta:         Plastic moment coefficient (only for spheres, 0 if rolling resistance is not used)
2.0e5  = Bn:          Cohesion Normal stiffness
2.0e5  = Bt:          Cohesion Tangential stiffness
1.0e3  = Bm:          Cohesion Torque stiffness
0.0     = Eps:        Cohesion Threshold
0.5     = R:           Spheroradius
1000    = seed:        Seed of the random generator
0.001   = dt:          Time step
0.5     = dtOut:       Time step for output
5.0    = Lx:          Lx (length of sphere cube)
5.0   = Ly:          Ly
5.0    = Lz:          Lz
4      = nx:          nx (number of spheres per cube size)
4     = ny:          ny
4      = nz:          nz
3.0     = rho:         rho
5.0     = p0:          Pressure for the isotropic compression
20.0      = T0:          Time span for the compression
1       = isfailure    Is a failure limited path
0       = pssrx:       Prescribed strain rate in X ?
0       = pssry:       Prescribed strain rate in Y ?
1       = pssrz:       Prescribed strain rate in Z ?
-0.05    = srx:         Final Strain x
-0.05    = sry:         Final Strain y
-0.05    = srz:        Final Strain z
5.0     = pf:          Final pressure p
0.0     = qf:          Final deviatoric stress q
50.0    = Tf:          Final time for the test